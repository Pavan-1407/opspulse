# Postgres connection string. Leave unset to use a local SQLite file.
DATABASE_URL=postgresql+psycopg2://opspulse:opspulse@localhost:5432/opspulse
# Seed synthetic demo data when the database is empty
SEED_ON_STARTUP=true
# Wipe and reseed on every boot (keeps a public demo fresh)
RESET_ON_STARTUP=false
